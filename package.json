{
  "name": "dsh-desktop-token-usage",
  "version": "0.1.7",
  "description": "Local-only DSH token usage dashboard: aggregates session logs under $DSH_HOME and renders them in the sidebar. Verified on DSH Desktop 0.1.7-rc.2, 0.2.0-rc.2 and 0.2.1-rc.2.",
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "translations/README-zh.md",
    "translations/CHANGELOG-zh.md",
    "!docs"
  ],
  "//translations-policy": "Only the Chinese document pair ships on npm; the other sixteen translated documents are GitHub-only. See scripts/verify-package.mjs, which asserts this list.",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm test && npm run test:package",
    "audit": "npm audit --omit=dev",
    "check:dicts": "node scripts/build-dicts.mjs --check",
    "check:release": "node scripts/prepare-release.mjs --check",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "usage",
    "dashboard",
    "statistics"
  ],
  "author": "jd04063221",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jd04063221/dsh-desktop-token-usage.git"
  },
  "homepage": "https://github.com/jd04063221/dsh-desktop-token-usage#readme",
  "bugs": {
    "url": "https://github.com/jd04063221/dsh-desktop-token-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  }
}
